---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="404">
  <section class="wrap py-24 sm:py-32">
    <p class="font-mono text-sm text-crit">404 · not found</p>
    <h1 class="mt-4 text-4xl font-bold sm:text-5xl">Esta ruta no existe</h1>
    <p class="mt-4 max-w-md text-muted">La enumeración no ha encontrado nada aquí. Vuelve al inicio.</p>
    <a href={withBase('/')} class="link mt-8 inline-block font-mono text-sm">cd ~</a>
  </section>
</BaseLayout>
