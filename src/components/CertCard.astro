---
import type { Cert } from '../data/certs';
import Icon from './Icon.astro';
import { getLang, useT } from '../i18n';

interface Props {
  cert: Cert;
}

const { cert } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);

const statusLabel = t(`cert.status.${cert.status}` as 'cert.status.obtenida');
const codeSize = cert.code.length >= 5 ? 'text-[0.9rem]' : 'text-[1.1rem]';
---

<article class:list={['cert-card', `is-${cert.status}`]} data-cert-card>
  <div class="cert-badge" aria-hidden="true">
    <span class="cert-badge-face">
      <span class="cert-sheen"></span>
      <span class:list={['cert-badge-code', codeSize]}>{cert.code}</span>
    </span>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-base leading-snug font-semibold text-text sm:text-lg">{cert.name}</h3>
      <span class="cert-pill">{statusLabel}</span>
    </div>
    <p class="mt-1.5 font-mono text-xs text-faint">{cert.issuer}{cert.date && ` · ${cert.date}`}</p>

    {cert.note && <p class="mt-3 text-sm text-muted">{cert.note}</p>}

    {
      cert.verifyUrl && (
        <a
          href={cert.verifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link mt-4 inline-flex items-center gap-1.5 font-mono text-xs"
        >
          {t('cert.verify')} <Icon name="arrow-right" size={14} />
        </a>
      )
    }
  </div>
</article>

<style>
  /* Tarjeta: minimalista y estática. Todo el "efecto" vive en la badge. */
  .cert-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid var(--line);
    border-left-width: 2px;
    border-radius: 0 0.7rem 0.7rem 0;
    background: var(--surface);
    padding: 1.4rem 1.5rem;
    transition: border-color 0.3s ease;
  }
  .is-obtenida {
    border-left-color: var(--accent);
  }
  .is-en-curso {
    border-left-color: var(--warn);
  }
  .is-planificada {
    border-left-color: var(--line-strong);
  }

  /* Emblema hexagonal; se inclina un poco siguiendo al ratón (--brx/--bry). */
  .cert-badge {
    width: 92px;
    height: 100px;
    flex: none;
    filter: drop-shadow(0 7px 14px rgba(0, 0, 0, 0.4));
    transform: perspective(520px) rotateX(var(--brx, 0deg)) rotateY(var(--bry, 0deg));
    transition: transform 0.18s ease;
  }
  .cert-badge-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    overflow: hidden;
    /* Metal oscuro: degradado base de tres paradas, tono frío. */
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--accent) 9%, var(--surface-raised)) 0%,
      var(--surface) 50%,
      color-mix(in srgb, #000000 14%, var(--surface)) 100%
    );
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--line-strong));
  }
  /* Micro-cepillado del metal (líneas finísimas). */
  .cert-badge-face::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      118deg,
      transparent 0 2px,
      color-mix(in srgb, #ffffff 4%, transparent) 2px 3px
    );
    opacity: 0.5;
    pointer-events: none;
  }
  /* Bisel especular fijo: borde superior iluminado, como una pieza biselada. */
  .cert-badge-face::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(158deg, color-mix(in srgb, #ffffff 20%, transparent), transparent 40%);
    pointer-events: none;
  }
  .cert-badge-code {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    /* Grabado: sombra abajo + luz arriba. */
    text-shadow:
      0 1px 1px rgba(0, 0, 0, 0.55),
      0 -1px 1px color-mix(in srgb, #ffffff 12%, transparent);
  }

  /* Destello único: una luz blanca que recorre la badge siguiendo al ratón. */
  .cert-sheen {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.22;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      60% 48% at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, #ffffff 40%, transparent),
      transparent 60%
    );
    mix-blend-mode: screen;
  }
  /* En la obtenida, el destello se intensifica al pasar el ratón. */
  .is-obtenida:hover .cert-sheen {
    opacity: 0.7;
  }
  /* Y la badge gana un halo cian muy sutil (acento único de la web). */
  .is-obtenida:hover .cert-badge {
    filter: drop-shadow(0 7px 14px rgba(0, 0, 0, 0.42))
      drop-shadow(0 0 9px color-mix(in srgb, var(--accent) 38%, transparent));
  }

  /* "Próximamente": emblema apagado, como bloqueado (sin destello). */
  .is-planificada .cert-badge-face {
    background: linear-gradient(150deg, var(--surface-raised), var(--surface));
    border-color: var(--line-strong);
  }
  .is-planificada .cert-badge-code {
    color: var(--text-faint);
  }
  .is-planificada .cert-badge {
    filter: drop-shadow(0 7px 14px rgba(0, 0, 0, 0.3));
    opacity: 0.85;
  }
  .is-planificada .cert-sheen {
    opacity: 0.06;
  }

  /* Píldora de estado */
  .cert-pill {
    flex: none;
    border: 1px solid;
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .is-obtenida .cert-pill {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }
  .is-en-curso .cert-pill {
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 40%, transparent);
    background: var(--warn-soft);
  }
  .is-planificada .cert-pill {
    color: var(--text-faint);
    border-color: var(--line-strong);
  }

  @media (max-width: 400px) {
    .cert-card {
      gap: 1rem;
      padding: 1.25rem;
    }
    .cert-badge {
      width: 76px;
      height: 84px;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-cert-card]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MAX = 9; // grados de inclinación de la badge

  cards.forEach((card) => {
    const badge = card.querySelector<HTMLElement>('.cert-badge');
    if (!badge) return;
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      // El foil se desplaza con el ratón (siempre).
      badge.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
      badge.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
      // El tilt solo con ratón fino y sin reduced-motion.
      if (fine && !reduce) {
        badge.style.setProperty('--bry', `${((px - 0.5) * 2 * MAX).toFixed(2)}deg`);
        badge.style.setProperty('--brx', `${(-(py - 0.5) * 2 * MAX).toFixed(2)}deg`);
      }
    });
    card.addEventListener('pointerleave', () => {
      badge.style.setProperty('--brx', '0deg');
      badge.style.setProperty('--bry', '0deg');
    });
  });
</script>
