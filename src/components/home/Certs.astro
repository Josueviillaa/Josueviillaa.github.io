---
import SectionHeader from '../SectionHeader.astro';
import CertCard from '../CertCard.astro';
import { certs } from '../../data/certs';
// TODO(Josu): añade certificaciones en src/data/certs.ts
---

<section id="certificaciones" class="border-b border-line">
  <div class="wrap py-20 sm:py-24">
    <SectionHeader n="03" label="certs" title="Certificaciones" />

    <div class="grid gap-5 md:grid-cols-2">
      {certs.map((cert) => <CertCard cert={cert} />)}
    </div>
  </div>
</section>
