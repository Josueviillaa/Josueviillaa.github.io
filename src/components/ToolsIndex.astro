---
import ToolCard from './ToolCard.astro';
import TermWindow from './lab/TermWindow.astro';
import Encoder from './lab/Encoder.astro';
import JwtTool from './lab/JwtTool.astro';
import EntropyMeter from './lab/EntropyMeter.astro';
import HashTool from './lab/HashTool.astro';
import Icon from './Icon.astro';
import { getTools } from '../lib/tools';
import { getLang, homeHref, useT } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang);

const tools = await getTools(lang);
---

<section class="wrap pt-10 pb-20 sm:pt-12 sm:pb-24">
  <a
    href={homeHref(lang)}
    class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-accent"
  >
    <Icon name="arrow-left" size={14} /> {t('writeups.back')}
  </a>

  <header class="mt-8 flex flex-col gap-3 border-b border-line pb-10">
    <p class="flex items-center gap-3 font-mono text-xs text-faint">
      <span class="font-medium text-accent">$</span>
      <span class="h-px w-8 bg-line-strong" aria-hidden="true"></span>
      <span>{t('tools.kicker')}</span>
    </p>
    <h1 class="text-4xl font-bold sm:text-5xl">{t('tools.title')}</h1>
    <p class="max-w-2xl text-muted">{t('tools.intro')}</p>
  </header>

  <p class="mt-10 flex items-center gap-3 font-mono text-xs text-faint">
    <span class="text-accent">//</span>
    <span>{t('tools.interactive')}</span>
    <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  </p>
  <div class="mt-5 grid items-start gap-5 lg:grid-cols-2">
    <TermWindow title="base64.sh" meta="encode · decode"><Encoder /></TermWindow>
    <TermWindow title="jwt.decode"><JwtTool /></TermWindow>
    <TermWindow title="entropy.calc"><EntropyMeter /></TermWindow>
    <TermWindow title="hashcat.run"><HashTool /></TermWindow>
  </div>

  {
    tools.length > 0 && (
      <>
        <p class="mt-14 flex items-center gap-3 font-mono text-xs text-faint">
          <span class="text-accent">//</span>
          <span>{t('tools.scripts')}</span>
          <span class="h-px flex-1 bg-line" aria-hidden="true" />
        </p>
        <ul class="mt-5 grid gap-5 [grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr))]">
          {tools.map((entry) => (
            <li>
              <ToolCard entry={entry} />
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>
