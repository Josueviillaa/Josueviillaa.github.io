---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
import Icon from '../components/Icon.astro';
import { formatDate, type Writeup } from '../lib/writeups';
import { withBase } from '../lib/url';

interface Props {
  entry: Writeup;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, platform, os, difficulty, date, ports, tags, summary, retired } = entry.data;

// Cada "## " del writeup es una fase
const phases = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${title} — writeup`} description={summary}>
  <article class="wrap pt-10 pb-20 sm:pt-12">
    <a
      href={withBase('/writeups/')}
      class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-accent"
    >
      <Icon name="arrow-left" size={14} /> writeups
    </a>

    <header class="mt-8 border-b border-line pb-10">
      <p class="font-mono text-xs text-faint">
        {platform} <span class="text-line-strong">/</span> máquina {retired ? 'retirada' : 'activa'}
      </p>
      <h1 class="mt-3 text-5xl font-bold sm:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{summary}</p>

      <dl
        class="mt-8 grid grid-cols-2 border-t border-l border-line font-mono text-[0.8125rem] sm:grid-cols-4"
      >
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">SO</dt>
          <dd class="mt-1 text-text">{os}</dd>
        </div>
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">dificultad</dt>
          <dd class="mt-1"><DifficultyBadge level={difficulty} /></dd>
        </div>
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">puertos</dt>
          <dd class="mt-1 text-text">{ports.length ? ports.join(' · ') : '—'}</dd>
        </div>
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">publicado</dt>
          <dd class="mt-1 text-text"><time datetime={date.toISOString()}>{formatDate(date)}</time></dd>
        </div>
      </dl>

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Técnicas">
            {tags.map((t) => (
              <li class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[0.6875rem] text-muted">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[13rem_minmax(0,1fr)]">
      {
        phases.length > 0 && (
          <nav aria-label="Fases" class="hidden lg:block">
            <div class="sticky top-[calc(var(--nav-h)+2rem)]">
              <p class="font-mono text-xs text-faint">fases</p>
              <ol class="mt-3 space-y-0.5 border-l border-line font-mono text-[0.8125rem]">
                {phases.map((h, i) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-phase-link={h.slug}
                      class="-ml-px flex gap-2.5 border-l border-transparent py-1 pl-3 text-muted transition-colors hover:text-text"
                    >
                      <span class="text-faint tabular-nums transition-colors">{String(i + 1).padStart(2, '0')}</span>
                      <span>{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
          <script>
            // Resalta la fase visible en la navegación lateral (scrollspy).
            const links = document.querySelectorAll<HTMLAnchorElement>('[data-phase-link]');
            const headings = [...links]
              .map((l) => document.getElementById(l.dataset.phaseLink!))
              .filter((el): el is HTMLElement => el !== null);

            function setActive(id: string) {
              links.forEach((l) => {
                const on = l.dataset.phaseLink === id;
                l.classList.toggle('border-accent', on);
                l.classList.toggle('text-text', on);
                l.classList.toggle('text-muted', !on);
                l.querySelector('span')?.classList.toggle('text-accent', on);
                l.querySelector('span')?.classList.toggle('text-faint', !on);
                if (on) l.setAttribute('aria-current', 'true');
                else l.removeAttribute('aria-current');
              });
            }

            if (headings.length) {
              const observer = new IntersectionObserver(
                (entries) => {
                  const visible = entries.filter((e) => e.isIntersecting);
                  if (visible.length) setActive(visible[0].target.id);
                },
                { rootMargin: '-20% 0px -70% 0px' },
              );
              headings.forEach((h) => observer.observe(h));
            }
          </script>
        )
      }

      <div class="writeup min-w-0 max-w-3xl">
        <slot />
      </div>
    </div>

    <footer class="mt-16 border-t border-line pt-6">
      <p class="max-w-3xl font-mono text-xs leading-relaxed text-faint">
        <span class="text-warn">aviso</span> · Contenido con fines educativos sobre una máquina
        {retired ? 'retirada' : ''} de {platform}, resuelta en su laboratorio autorizado. Se explican los conceptos de cada
        vector, no se publican credenciales ni payloads listos para usar. No apliques estas técnicas contra sistemas sin
        permiso explícito.
      </p>
    </footer>
  </article>
</BaseLayout>
