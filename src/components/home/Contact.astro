---
import SectionHeader from '../SectionHeader.astro';
import CopyEmail from '../CopyEmail.astro';
import { site, githubUrl, linkedinUrl } from '../../config/site';
import { getLang, useT } from '../../i18n';
// Email y usuarios se editan en src/config/site.ts

const lang = getLang(Astro.url);
const t = useT(lang);
---

<section id="contacto">
  <div class="wrap py-20 sm:py-24">
    <SectionHeader n="05" label={t('contact.kicker')} title={t('contact.title')} />

    <div class="grid gap-10 md:grid-cols-[1fr_1.2fr]">
      <p class="max-w-md text-lg text-muted">{t('contact.body')}</p>

      <dl class="border-t border-line font-mono text-[0.8125rem]">
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-3 border-b border-line py-4">
          <dt class="text-faint">email</dt>
          <dd class="min-w-0"><CopyEmail email={site.email} /></dd>
        </div>
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-3 border-b border-line py-4">
          <dt class="text-faint">github</dt>
          <dd class="min-w-0 break-all">
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="link">
              github.com/{site.links.github}
            </a>
          </dd>
        </div>
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-3 border-b border-line py-4">
          <dt class="text-faint">linkedin</dt>
          <dd class="min-w-0 break-all">
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="link">
              linkedin.com/in/{site.links.linkedin}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
