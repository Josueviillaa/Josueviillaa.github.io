---
import type { Cert } from '../data/certs';
import Icon from './Icon.astro';
import { getLang, useT } from '../i18n';

interface Props {
  cert: Cert;
}

const { cert } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);

const statusLabel = t(`cert.status.${cert.status}` as 'cert.status.obtenida');
// Código grabado en el centro; se encoge si es largo.
const codeFont = cert.code.length >= 5 ? 19 : 25;
const codeY = (110 + codeFont * 0.34).toFixed(1);
const gid = `m-${cert.code}`;
---

<article class:list={['cert-card', `is-${cert.status}`]} data-cert-card>
  <div class="cert-badge" data-cert-badge aria-hidden="true">
    <svg class="cert-medal" viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id={gid} x1="0.15" y1="0" x2="0.5" y2="1">
          <stop offset="0" stop-color="#4b545f"></stop>
          <stop offset="0.5" stop-color="#2d343d"></stop>
          <stop offset="1" stop-color="#1a202a"></stop>
        </linearGradient>
      </defs>

      <!-- Superficie metálica lisa (un solo degradado, sin facetas) -->
      <polygon points="100,0 200,55 200,165 100,220 0,165 0,55" fill={`url(#${gid})`}></polygon>

      <!-- Brillo superior muy sutil (gloss) -->
      <polygon points="100,0 200,55 100,112 0,55" fill="#ffffff" opacity="0.05"></polygon>

      <!-- Aro fino exterior (acento) + hairline interior -->
      <polygon
        class="rim"
        points="100,0 200,55 200,165 100,220 0,165 0,55"
        fill="none"
        stroke-width="1.2"></polygon>
      <polygon
        points="100,7 192,57 192,163 100,213 8,163 8,57"
        fill="none"
        stroke="#ffffff"
        stroke-width="0.5"
        opacity="0.07"></polygon>

      <!-- Código grabado (sombra + luz) -->
      <text
        x="100"
        y={codeY}
        text-anchor="middle"
        fill="#05100d"
        opacity="0.5"
        style={`font-family:var(--font-display);font-weight:600;font-size:${codeFont}px;letter-spacing:-0.01em`}
        transform="translate(0,1)">{cert.code}</text>
      <text
        class="code"
        x="100"
        y={codeY}
        text-anchor="middle"
        style={`font-family:var(--font-display);font-weight:600;font-size:${codeFont}px;letter-spacing:-0.01em`}
        >{cert.code}</text>
    </svg>

    <!-- Reflejo fino que glisa con el ratón -->
    <span class="cert-shine"></span>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-base leading-snug font-semibold text-text sm:text-lg">{cert.name}</h3>
      <span class="cert-pill">{statusLabel}</span>
    </div>
    <p class="mt-1.5 font-mono text-xs text-faint">{cert.issuer}{cert.date && ` · ${cert.date}`}</p>

    {cert.note && <p class="mt-3 text-sm text-muted">{cert.note}</p>}

    {
      cert.verifyUrl && (
        <a
          href={cert.verifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link mt-4 inline-flex items-center gap-1.5 font-mono text-xs"
        >
          {t('cert.verify')} <Icon name="arrow-right" size={14} />
        </a>
      )
    }
  </div>
</article>

<style>
  /* Posición del reflejo (0–100). Registrada para transicionarla: el brillo
     glisa hacia el ratón en vez de saltar. */
  @property --mx {
    syntax: '<number>';
    inherits: true;
    initial-value: 50;
  }
  @property --my {
    syntax: '<number>';
    inherits: true;
    initial-value: 32;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid var(--line);
    border-left-width: 2px;
    border-radius: 0 0.7rem 0.7rem 0;
    background: var(--surface);
    padding: 1.4rem 1.5rem;
    transition: border-color 0.3s ease;
  }
  .is-obtenida {
    border-left-color: var(--accent);
  }
  .is-en-curso {
    border-left-color: var(--warn);
  }
  .is-planificada {
    border-left-color: var(--line-strong);
  }

  /* Emblema — fino y sobrio */
  .cert-badge {
    --mx: 50;
    --my: 32;
    --rim: var(--accent);
    position: relative;
    width: 84px;
    height: 92px;
    flex: none;
    filter: drop-shadow(0 5px 12px rgba(0, 0, 0, 0.38));
    transition:
      --mx 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      --my 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s ease,
      filter 0.4s ease;
  }
  .is-en-curso .cert-badge {
    --rim: var(--warn);
  }
  .is-planificada .cert-badge {
    --rim: var(--line-strong);
    filter: drop-shadow(0 5px 12px rgba(0, 0, 0, 0.28)) grayscale(0.4) brightness(0.86);
    opacity: 0.82;
  }

  .cert-medal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .rim {
    stroke: var(--rim);
    opacity: 0.4;
  }
  .code {
    fill: #e8eef2;
  }
  .is-planificada .code {
    fill: #aeb8c0;
  }

  /* Reflejo: un único foco de luz blando, recortado al hexágono. Discreto. */
  .cert-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: radial-gradient(
      46% 40% at calc(var(--mx) * 1%) calc(var(--my) * 1%),
      rgba(255, 255, 255, 0.22),
      rgba(255, 255, 255, 0) 66%
    );
    mix-blend-mode: screen;
    opacity: 0.9;
    transition: opacity 0.4s ease;
  }
  .is-planificada .cert-shine {
    opacity: 0.1;
  }

  /* Hover: sube un pelo y aparece un halo muy tenue del acento. */
  .cert-card:hover .cert-badge {
    transform: translateY(-2px);
  }
  .is-obtenida:hover .cert-badge,
  .is-en-curso:hover .cert-badge {
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.42))
      drop-shadow(0 0 8px color-mix(in srgb, var(--rim) 30%, transparent));
  }
  .cert-card:hover .cert-shine {
    opacity: 1;
  }

  /* Píldora de estado */
  .cert-pill {
    flex: none;
    border: 1px solid;
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .is-obtenida .cert-pill {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }
  .is-en-curso .cert-pill {
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 40%, transparent);
    background: var(--warn-soft);
  }
  .is-planificada .cert-pill {
    color: var(--text-faint);
    border-color: var(--line-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-badge {
      transition: filter 0.3s ease;
    }
    .cert-card:hover .cert-badge {
      transform: none;
    }
  }

  @media (max-width: 400px) {
    .cert-card {
      gap: 1rem;
      padding: 1.25rem;
    }
    .cert-badge {
      width: 72px;
      height: 79px;
    }
  }
</style>

<script>
  const badges = document.querySelectorAll<HTMLElement>('[data-cert-badge]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  badges.forEach((badge) => {
    const card = badge.closest<HTMLElement>('[data-cert-card]');
    if (!card || reduce) return;
    card.addEventListener('pointermove', (e) => {
      const r = badge.getBoundingClientRect();
      const mx = ((e.clientX - r.left) / r.width) * 100;
      const my = ((e.clientY - r.top) / r.height) * 100;
      badge.style.setProperty('--mx', Math.max(-20, Math.min(120, mx)).toFixed(1));
      badge.style.setProperty('--my', Math.max(-20, Math.min(120, my)).toFixed(1));
    });
    card.addEventListener('pointerleave', () => {
      badge.style.setProperty('--mx', '50');
      badge.style.setProperty('--my', '32');
    });
  });
</script>
