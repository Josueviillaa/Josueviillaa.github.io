---
/**
 * Switch de idioma ES / EN, discreto, para el nav.
 * El idioma activo va en acento; el otro es un enlace a su home.
 * (Los writeups son solo español: desde cualquier página el enlace
 *  lleva a la home del idioma correspondiente.)
 */
import { getLang, switchHref, useT, type Lang } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang);

const options: { code: Lang; label: string; name: string }[] = [
  { code: 'es', label: 'ES', name: 'Español' },
  { code: 'en', label: 'EN', name: 'English' },
];
---

<div class="flex items-center gap-1 font-mono text-xs" role="group" aria-label={t('lang.aria')}>
  {
    options.map((o, i) => (
      <>
        {i > 0 && <span class="text-line-strong" aria-hidden="true">/</span>}
        {o.code === lang ? (
          <span class="text-accent" aria-current="true">
            <span aria-hidden="true">{o.label}</span>
            <span class="sr-only">{o.name}</span>
          </span>
        ) : (
          <a
            href={switchHref(Astro.url, o.code)}
            hreflang={o.code}
            lang={o.code}
            aria-label={o.name}
            class="text-faint transition-colors hover:text-text"
          >
            <span aria-hidden="true">{o.label}</span>
          </a>
        )}
      </>
    ))
  }
</div>
