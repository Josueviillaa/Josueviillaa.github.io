---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import { withBase } from '../lib/url';
import { getLang, homeHref, useT } from '../i18n';

interface Props {
  /** En la home los enlaces de ancla son puros; desde otra página apuntan a la home. */
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const lang = getLang(Astro.url);
const t = useT(lang);
const home = homeHref(lang);
const path = Astro.url.pathname;

// Ruta con prefijo de idioma para las páginas aparte (writeups, notas).
const pageHref = (p: string) => withBase(lang === 'en' ? `/en${p}` : p);

// El nav mezcla anclas de la home (sobre mí, skills…) con páginas propias
// (writeups, notas): "writeups" lleva a su listado, no hace scroll.
type NavItem =
  | { kind: 'anchor'; id: string; label: string }
  | { kind: 'page'; href: string; label: string };

const items: NavItem[] = [
  { kind: 'anchor', id: 'sobre-mi', label: t('nav.about') },
  { kind: 'anchor', id: 'skills', label: t('nav.skills') },
  { kind: 'anchor', id: 'certificaciones', label: t('nav.certs') },
  { kind: 'page', href: pageHref('/writeups/'), label: t('nav.writeups') },
  { kind: 'anchor', id: 'contacto', label: t('nav.contact') },
  { kind: 'page', href: pageHref('/notas/'), label: t('nav.notes') },
];

const anchorHref = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
const isActivePage = (href: string) => path.startsWith(href);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="wrap flex h-(--nav-h) items-center justify-between gap-4" aria-label={t('nav.aria')}>
    <a href={isHome ? '#top' : home} class="font-mono text-sm font-medium text-text">
      <span class="text-faint">~/</span>josue<span class="cursor" aria-hidden="true"></span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <ul class="hidden items-center gap-6 font-mono text-[0.8125rem] md:flex">
        {
          items.map((item, i) =>
            item.kind === 'anchor' ? (
              <li>
                <a href={anchorHref(item.id)} data-nav-link={item.id} class="text-muted transition-colors hover:text-text">
                  <span class="text-faint">{num(i)}.</span>
                  {item.label}
                </a>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActivePage(item.href) ? 'page' : undefined}
                  class:list={['transition-colors hover:text-text', isActivePage(item.href) ? 'text-accent' : 'text-muted']}
                >
                  <span class="text-faint">{num(i)}.</span>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="flex items-center gap-2 sm:gap-3">
        <LangSwitch />
        <span class="hidden h-4 w-px bg-line sm:inline-block" aria-hidden="true"></span>
        <ThemeToggle />
        <button
          type="button"
          data-menu-button
          aria-expanded="false"
          aria-controls="nav-menu"
          data-label-open={t('nav.menu')}
          data-label-close={t('nav.close')}
          class="inline-flex h-9 items-center rounded-md border border-line px-3 font-mono text-xs text-muted transition-colors hover:text-text md:hidden"
        >
          {t('nav.menu')}
        </button>
      </div>
    </div>
  </nav>

  <div id="nav-menu" hidden class="border-t border-line md:hidden">
    <ul class="wrap flex flex-col py-2 font-mono text-sm">
      {
        items.map((item, i) =>
          item.kind === 'anchor' ? (
            <li>
              <a href={anchorHref(item.id)} data-nav-link={item.id} class="flex gap-3 py-2.5 text-muted hover:text-text">
                <span class="text-faint">{num(i)}.</span>
                {item.label}
              </a>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActivePage(item.href) ? 'page' : undefined}
                class:list={['flex gap-3 py-2.5 hover:text-text', isActivePage(item.href) ? 'text-accent' : 'text-muted']}
              >
                <span class="text-faint">{num(i)}.</span>
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </div>
</header>

<script>
  // Menú móvil
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('nav-menu');
  const labelOpen = button?.dataset.labelOpen ?? 'menu';
  const labelClose = button?.dataset.labelClose ?? 'close';

  function setOpen(open: boolean) {
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', String(open));
    button.textContent = open ? labelClose : labelOpen;
    menu.hidden = !open;
  }

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Resalta la sección de la home visible (solo anclas)
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const targets = [...new Set([...links].map((l) => l.dataset.navLink))]
    .map((id) => document.getElementById(id!))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => {
            const active = l.dataset.navLink === entry.target.id;
            l.classList.toggle('text-accent', active);
            l.classList.toggle('text-muted', !active);
            if (active) l.setAttribute('aria-current', 'true');
            else l.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
