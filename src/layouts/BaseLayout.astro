---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Shortcuts from '../components/Shortcuts.astro';
import MatrixRain from '../components/MatrixRain.astro';
import BootIntro from '../components/BootIntro.astro';
import { site, content, githubUrl, linkedinUrl, htbUrl } from '../config/site';
import { withBase } from '../lib/url';
import { getLang, useT, localeTag, ogLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  /** Clase extra para <body> (p. ej. "is-cv" para aislar la página de CV al imprimir). */
  bodyClass?: string;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const c = content[lang];

const { title, description = c.description, isHome = false, bodyClass = '' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${c.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

// hreflang para la home (las dos versiones de idioma)
const esHome = new URL(withBase('/'), Astro.site);
const enHome = new URL(withBase('/en/'), Astro.site);

// Datos estructurados (schema.org Person) — ayuda a buscadores a entender quién es Josu.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: c.role,
  description: c.description,
  url: esHome.href,
  email: `mailto:${site.email}`,
  sameAs: [githubUrl, linkedinUrl, htbUrl],
  knowsLanguage: ['Spanish', 'English'],
  knowsAbout: [
    'Penetration testing',
    'Offensive security',
    'Active Directory',
    'Web application security',
    'Privilege escalation',
    'OWASP Top 10',
    'HackTheBox',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'eJPT (eLearnSecurity Junior Penetration Tester)',
  },
};
---

<!doctype html>
<html lang={localeTag[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {
      isHome && (
        <>
          <link rel="alternate" hreflang="es" href={esHome} />
          <link rel="alternate" hreflang="en" href={enHome} />
          <link rel="alternate" hreflang="x-default" href={esHome} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · writeups y notas`} href={withBase('/rss.xml')} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(withBase('/og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${c.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(withBase('/og.png'), Astro.site)} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

    <script is:inline>
      try {
        const ac = localStorage.getItem('accent');
        if (ac) document.documentElement.dataset.accent = ac;
        if (localStorage.getItem('crt') === '1') document.documentElement.dataset.crt = '';
      } catch {}
    </script>

    {
      /* Primera visita a la home: redirige a /en/ si el navegador no está en español. */
      isHome && lang === 'es' && (
        <script
          is:inline
          set:html={`try{if(!localStorage.getItem('lang')){var n=(navigator.language||'').toLowerCase();if(n&&n.indexOf('es')!==0){localStorage.setItem('lang','en');location.replace(${JSON.stringify(enHome.pathname)});}else{localStorage.setItem('lang','es');}}}catch(e){}`}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
    />
  </head>

  <body id="top" class={bodyClass}>
    <BootIntro />
    <div id="read-progress" aria-hidden="true" class="pointer-events-none fixed top-0 left-0 z-[60] h-0.5 w-full origin-left bg-accent"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:font-mono focus:text-sm focus:text-accent-ink"
    >
      {t('a11y.skip')}
    </a>

    <Nav isHome={isHome} />

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="wrap flex flex-col gap-2 py-8 font-mono text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {site.name}</p>
        <div class="flex items-center gap-4">
          <a href={withBase(lang === 'en' ? '/en/aviso-legal/' : '/aviso-legal/')} class="transition-colors hover:text-text">
            {t('legal.nav')}
          </a>
          <a href={withBase(lang === 'en' ? '/en/privacy/' : '/privacidad/')} class="transition-colors hover:text-text">
            {t('privacy.nav')}
          </a>
          <a href={withBase('/rss.xml')} class="transition-colors hover:text-text">rss</a>
          <button type="button" data-matrix-toggle class="transition-colors hover:text-accent">matrix</button>
          <button type="button" data-crt-toggle class="transition-colors hover:text-accent">crt</button>
          <span data-secrets hidden class="text-faint"></span>
        </div>
        <p>{t('footer.note')}</p>
      </div>
    </footer>

    <PrivacyNotice />
    <CommandPalette />
    <Shortcuts />
    <MatrixRain />

    <div
      data-flag-toast
      hidden
      class="fixed bottom-4 left-1/2 z-[120] -translate-x-1/2 rounded-md border border-accent/50 bg-surface px-4 py-2 font-mono text-sm text-accent shadow-xl"
    >
      flag&#123;sh4rk_was_h3r3&#125; <span class="text-faint">// gg</span>
    </div>

    <div
      data-secret-toast
      hidden
      class="fixed bottom-4 left-1/2 z-[120] -translate-x-1/2 rounded-md border border-accent/50 bg-surface px-4 py-2 font-mono text-xs text-accent shadow-xl"
    >
    </div>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-matrix-toggle]').forEach((b) =>
          b.addEventListener('click', () => document.dispatchEvent(new Event('matrix:toggle'))),
        );
        document.querySelectorAll('[data-crt-toggle]').forEach((b) =>
          b.addEventListener('click', () => {
            const r = document.documentElement;
            const on = r.hasAttribute('data-crt');
            if (on) { r.removeAttribute('data-crt'); try { localStorage.removeItem('crt'); } catch {} }
            else { r.setAttribute('data-crt', ''); try { localStorage.setItem('crt', '1'); } catch {} window.__secret && window.__secret('crt'); }
          }),
        );
        try {
          console.log('%c~/sh4rk', 'color:#22c55e;font:700 20px monospace');
          console.log('%cteclea el konami o pulsa matrix en el pie. // konami code, or hit matrix in the footer.', 'color:#7d8590;font:12px monospace');
        } catch {}
        const seq = [38, 38, 40, 40, 37, 39, 37, 39, 66, 65];
        let pos = 0;
        const toast = document.querySelector('[data-flag-toast]');
        let hideT = 0;
        function showFlag() {
          try { console.log('%cflag{sh4rk_was_h3r3}', 'color:#22c55e;font:700 14px monospace'); } catch {}
          if (!toast) return;
          toast.hidden = false;
          clearTimeout(hideT);
          hideT = window.setTimeout(() => (toast.hidden = true), 5000);
        }
        document.addEventListener('keydown', (e) => {
          pos = e.keyCode === seq[pos] ? pos + 1 : e.keyCode === seq[0] ? 1 : 0;
          if (pos === seq.length) {
            pos = 0;
            document.dispatchEvent(new Event('matrix:toggle'));
            showFlag();
            window.__secret && window.__secret('flag');
          }
        });
      })();
    </script>

    <script is:inline>
      (function () {
        function closeAll(except) {
          document.querySelectorAll('abbr.gl.is-open').forEach(function (el) {
            if (el !== except) el.classList.remove('is-open');
          });
        }
        document.addEventListener('click', function (e) {
          var el = e.target instanceof Element ? e.target.closest('abbr.gl') : null;
          if (el) {
            e.preventDefault();
            var open = el.classList.contains('is-open');
            closeAll(el);
            el.classList.toggle('is-open', !open);
          } else {
            closeAll(null);
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeAll(null);
        });
      })();
    </script>

    <script>
      const SECRETS: Record<string, string> = { recon: 'recon', matrix: 'matrix rain', crt: 'crt', flag: 'flag', shortcuts: 'atajos' };
      const SECRET_TOTAL = Object.keys(SECRETS).length;
      const secretCounter = document.querySelector<HTMLElement>('[data-secrets]');
      const secretToast = document.querySelector<HTMLElement>('[data-secret-toast]');
      let secretToastTimer = 0;
      const readSecrets = (): Set<string> => {
        try {
          return new Set(JSON.parse(localStorage.getItem('secrets') || '[]'));
        } catch {
          return new Set();
        }
      };
      const renderSecrets = (n: number) => {
        if (secretCounter) {
          secretCounter.textContent = `secrets ${n}/${SECRET_TOTAL}`;
          secretCounter.hidden = n === 0;
        }
      };
      (window as unknown as { __secret?: (id: string) => void }).__secret = (id: string) => {
        if (!(id in SECRETS)) return;
        const set = readSecrets();
        if (set.has(id)) return;
        set.add(id);
        try {
          localStorage.setItem('secrets', JSON.stringify([...set]));
        } catch {}
        renderSecrets(set.size);
        if (secretToast) {
          secretToast.textContent = `🔓 ${SECRETS[id]} · ${set.size}/${SECRET_TOTAL}`;
          secretToast.hidden = false;
          window.clearTimeout(secretToastTimer);
          secretToastTimer = window.setTimeout(() => (secretToast.hidden = true), 3500);
        }
      };
      renderSecrets(readSecrets().size);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (ents, obs) => {
            ents.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('reveal-in');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll<HTMLElement>('main section, main article').forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.88) el.classList.add('reveal-in');
          else {
            el.classList.add('reveal');
            io.observe(el);
          }
        });
        window.setTimeout(() => {
          document.querySelectorAll('.reveal:not(.reveal-in)').forEach((el) => el.classList.add('reveal-in'));
        }, 2500);
      }

      document.querySelectorAll<HTMLPreElement>('.writeup pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.textContent = 'copy';
        btn.setAttribute('aria-label', 'Copiar código');
        btn.addEventListener('click', async () => {
          const code = (pre.querySelector('code') || pre).textContent || '';
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = 'copied';
            window.setTimeout(() => (btn.textContent = 'copy'), 1500);
          } catch {}
        });
        pre.appendChild(btn);
      });

      document.querySelectorAll<HTMLElement>('.writeup h2[id], .writeup h3[id]').forEach((h) => {
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.className = 'heading-anchor';
        a.textContent = '#';
        a.setAttribute('aria-label', 'Enlace a esta sección');
        h.appendChild(a);
      });

      const bar = document.getElementById('read-progress');
      if (bar) {
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`;
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
    </script>
  </body>
</html>
