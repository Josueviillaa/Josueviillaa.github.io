---
import DifficultyBadge from './DifficultyBadge.astro';
import Icon from './Icon.astro';
import { formatDate, type Writeup } from '../lib/writeups';
import { withBase } from '../lib/url';

interface Props {
  entry: Writeup;
}

const { entry } = Astro.props;
const { title, platform, os, difficulty, tags, summary, date } = entry.data;
const MAX_TAGS = 5;
---

<a
  href={withBase(`/writeups/${entry.id}/`)}
  class="group flex h-full flex-col rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent/60 sm:p-6"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-mono text-xs text-faint">{platform} · {os}</p>
      <h3 class="mt-1 text-2xl font-semibold transition-colors group-hover:text-accent">{title}</h3>
    </div>
    <DifficultyBadge level={difficulty} />
  </div>

  <p class="mt-3 text-sm text-muted">{summary}</p>

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Técnicas">
    {tags.slice(0, MAX_TAGS).map((t) => <li class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[0.6875rem] text-muted">{t}</li>)}
    {tags.length > MAX_TAGS && <li class="px-1 py-0.5 font-mono text-[0.6875rem] text-faint">+{tags.length - MAX_TAGS}</li>}
  </ul>

  <div class="mt-auto flex items-center justify-between pt-6 font-mono text-xs">
    <time datetime={date.toISOString()} class="text-faint">{formatDate(date)}</time>
    <span class="inline-flex items-center gap-1.5 text-accent">
      leer writeup <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
