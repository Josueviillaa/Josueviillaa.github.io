---
import Icon from '../Icon.astro';
import CopyEmail from '../CopyEmail.astro';
import HeroTerminal from './HeroTerminal.astro';
import { site, content, githubUrl, linkedinUrl, htbUrl } from '../../config/site';
import { withBase } from '../../lib/url';
import { getLang, useT } from '../../i18n';

const lang = getLang(Astro.url);
const t = useT(lang);
const c = content[lang];
const writeupsHref = withBase(lang === 'en' ? '/en/writeups/' : '/writeups/');
---

<section class="relative overflow-hidden border-b border-line">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-60 [background-image:linear-gradient(var(--line)_1px,transparent_1px),linear-gradient(90deg,var(--line)_1px,transparent_1px)] [background-size:2rem_2rem] [mask-image:radial-gradient(ellipse_70%_80%_at_20%_0%,black,transparent_75%)]"
  >
  </div>

  <div class="wrap relative grid items-center gap-12 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:grid-cols-[1.25fr_1fr]">
    <div class="min-w-0">
      <p class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-muted">
        <span class="status-dot" aria-hidden="true"></span>
        <span>{c.status}</span>
      </p>

      <p class="mt-7 font-mono text-sm tracking-[0.25em] text-faint uppercase">
        <span class="text-accent">{site.handle}</span> · {site.name}
      </p>

      <h1 data-scramble class="mt-3 font-display text-[2rem] font-bold leading-[1.08] tracking-tight text-text sm:text-5xl">
        {c.headline}
      </h1>

      <p class="mt-5 font-display text-lg font-medium text-muted sm:text-xl">{c.role}</p>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:text-lg">{c.pitch}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={writeupsHref}
          class="glow-accent inline-flex h-9 items-center gap-2 rounded-md bg-accent px-3.5 font-mono text-[0.8125rem] font-medium text-accent-ink"
        >
          {t('hero.cta')} <Icon name="arrow-right" size={15} />
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="github" /> GitHub
        </a>
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="linkedin" /> LinkedIn
        </a>
        <a
          href={htbUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="htb" /> HackTheBox
        </a>
        <CopyEmail email={site.email} />
      </div>
    </div>

    <HeroTerminal />
  </div>
</section>

<script>
  // El titular se "descifra" al cargar (scramble), de izquierda a derecha,
  // suave y por tiempo. El texto real está en el HTML (SEO/no-JS); esto solo
  // lo anima. Se omite con prefers-reduced-motion.
  const el = document.querySelector<HTMLElement>('[data-scramble]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const final = el.textContent || '';
    // Glifos de ancho parecido (letras/dígitos) para que no cambie el wrap.
    const glyphs = 'abcdefghijklmnopqrstuvwxyz0123456789';
    // Reserva el alto final: el contenido de abajo no se mueve durante la animación.
    el.style.minHeight = `${el.offsetHeight}px`;

    const DURATION = 1500; // ms
    const FLICKER = 55; // ms entre cambios de glifo de las letras sin revelar
    const scrambled = Array.from(final, () => glyphs[(Math.random() * glyphs.length) | 0]);
    let start = 0;
    let lastFlicker = 0;

    function frame(now: number) {
      if (!start) start = now;
      const t = Math.min(1, (now - start) / DURATION);
      const eased = 1 - Math.pow(1 - t, 3); // ease-out cúbico (frena al final)
      const revealed = Math.floor(eased * final.length);
      const flicker = now - lastFlicker > FLICKER;
      if (flicker) lastFlicker = now;

      let outText = '';
      for (let i = 0; i < final.length; i++) {
        if (final[i] === ' ' || i < revealed) {
          outText += final[i];
        } else {
          if (flicker) scrambled[i] = glyphs[(Math.random() * glyphs.length) | 0];
          outText += scrambled[i];
        }
      }
      el!.textContent = outText;

      if (t < 1) requestAnimationFrame(frame);
      else finalize();
    }
    function finalize() {
      el!.textContent = final;
      el!.style.minHeight = '';
    }
    requestAnimationFrame(frame);
    // Red de seguridad: si el rAF se pausa (pestaña en segundo plano), deja el
    // estado final igualmente.
    setTimeout(finalize, DURATION + 400);
  }
</script>
