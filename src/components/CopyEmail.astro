---
/**
 * Email como texto seleccionable + botón de copiar.
 * Sin mailto: muchos reclutadores no tienen cliente de correo configurado.
 */
import { getLang, useT } from '../i18n';

interface Props {
  email: string;
  class?: string;
}

const { email, class: className } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
---

<div
  data-copy-email
  data-label={t('copy.label')}
  data-done={t('copy.done')}
  data-fallback={t('copy.fallback')}
  data-status-ok={t('copy.status_ok')}
  data-status-fallback={t('copy.status_fallback')}
  class:list={[
    'inline-flex max-w-full items-stretch overflow-hidden rounded-md border border-line bg-surface font-mono text-[0.8125rem]',
    className,
  ]}
>
  <span data-copy-text class="min-w-0 select-all px-3 py-2 break-all text-text">{email}</span>
  <button
    type="button"
    data-copy-button
    class="shrink-0 border-l border-line px-3 text-muted transition-colors hover:bg-raised hover:text-accent"
    aria-label={`${t('copy.aria_prefix')} ${email} ${t('copy.aria_suffix')}`}
  >
    <span data-copy-label>{t('copy.label')}</span>
  </button>
  <span data-copy-status class="sr-only" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((root) => {
    const text = root.querySelector<HTMLElement>('[data-copy-text]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-copy-button]')!;
    const label = root.querySelector<HTMLElement>('[data-copy-label]')!;
    const status = root.querySelector<HTMLElement>('[data-copy-status]')!;
    const msg = {
      label: root.dataset.label ?? 'copy',
      done: root.dataset.done ?? 'copied',
      fallback: root.dataset.fallback ?? 'ctrl+c',
      ok: root.dataset.statusOk ?? '',
      selected: root.dataset.statusFallback ?? '',
    };
    let timer: number | undefined;

    function selectText() {
      const range = document.createRange();
      range.selectNodeContents(text);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    }

    function flash(text: string, ok: boolean) {
      label.textContent = text;
      status.textContent = ok ? msg.ok : msg.selected;
      button.classList.toggle('text-accent', ok);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = msg.label;
        button.classList.remove('text-accent');
      }, 1800);
    }

    button.addEventListener('click', async () => {
      const value = text.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(value);
        flash(msg.done, true);
      } catch {
        // Sin API de portapapeles (http, permisos…): dejamos el texto seleccionado.
        selectText();
        flash(msg.fallback, false);
      }
    });
  });
</script>
