---
import Icon from './Icon.astro';
import { formatDate } from '../lib/writeups';
import { withBase } from '../lib/url';
import { getLang, useT } from '../i18n';
import type { Note } from '../lib/notes';

interface Props {
  entry: Note;
}

const { entry } = Astro.props;
const { title, topic, tags, summary, date } = entry.data;
const MAX_TAGS = 5;

const lang = getLang(Astro.url);
const t = useT(lang);
---

<a
  href={withBase(`/notas/${entry.id}/`)}
  class="group flex h-full flex-col rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent/60 sm:p-6"
>
  <p class="font-mono text-xs text-faint"><span class="text-accent">#</span> {topic}</p>
  <h3 class="mt-1 text-2xl font-semibold transition-colors group-hover:text-accent">{title}</h3>

  <p class="mt-3 text-sm text-muted">{summary}</p>

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t('card.techniques')}>
    {tags.slice(0, MAX_TAGS).map((tag) => <li class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[0.6875rem] text-muted">{tag}</li>)}
    {tags.length > MAX_TAGS && <li class="px-1 py-0.5 font-mono text-[0.6875rem] text-faint">+{tags.length - MAX_TAGS}</li>}
  </ul>

  <div class="mt-auto flex items-center justify-between pt-6 font-mono text-xs">
    <time datetime={date.toISOString()} class="text-faint">{formatDate(date, lang)}</time>
    <span class="inline-flex items-center gap-1.5 text-accent">
      {t('note.read')} <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
