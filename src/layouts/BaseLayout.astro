---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site, content, githubUrl, linkedinUrl } from '../config/site';
import { withBase } from '../lib/url';
import { getLang, useT, localeTag, ogLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const c = content[lang];

const { title, description = c.description, isHome = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${c.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

// hreflang para la home (las dos versiones de idioma)
const esHome = new URL(withBase('/'), Astro.site);
const enHome = new URL(withBase('/en/'), Astro.site);

// Datos estructurados (schema.org Person) — ayuda a buscadores a entender quién es Josu.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: c.role,
  description: c.description,
  url: esHome.href,
  email: `mailto:${site.email}`,
  sameAs: [githubUrl, linkedinUrl],
  knowsLanguage: ['Spanish', 'English'],
  knowsAbout: [
    'Penetration testing',
    'Offensive security',
    'Active Directory',
    'Web application security',
    'Privilege escalation',
    'OWASP Top 10',
    'HackTheBox',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'eJPT — eLearnSecurity Junior Penetration Tester',
  },
};
---

<!doctype html>
<html lang={localeTag[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {
      isHome && (
        <>
          <link rel="alternate" hreflang="es" href={esHome} />
          <link rel="alternate" hreflang="en" href={enHome} />
          <link rel="alternate" hreflang="x-default" href={esHome} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

    <!-- Aplica el tema guardado ANTES de pintar, para evitar parpadeo -->
    <script is:inline>
      try {
        const tm = localStorage.getItem('theme');
        if (tm === 'light' || tm === 'dark') document.documentElement.dataset.theme = tm;
      } catch {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>

  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:font-mono focus:text-sm focus:text-accent-ink"
    >
      {t('a11y.skip')}
    </a>

    <Nav isHome={isHome} />

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="wrap flex flex-col gap-2 py-8 font-mono text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {site.name}</p>
        <p>{t('footer.note')}</p>
      </div>
    </footer>
  </body>
</html>
