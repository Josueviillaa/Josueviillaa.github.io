---
import Icon from '../Icon.astro';
import { withBase } from '../../lib/url';
import { getLang, useT } from '../../i18n';

interface Neighbour {
  id: string;
  title: string;
}

interface Props {
  prev?: Neighbour | null;
  next?: Neighbour | null;
}

const { prev, next } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);

const href = (id: string) => withBase(`/writeups/${id}/`);
---

{
  (prev || next) && (
    <nav aria-label={t('pager.aria')} class="mt-14 grid gap-4 sm:grid-cols-2">
      {prev ? (
        <a
          href={href(prev.id)}
          rel="prev"
          class="group flex flex-col gap-2 rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent/60"
        >
          <span class="inline-flex items-center gap-1.5 font-mono text-[0.6875rem] tracking-[0.2em] text-accent uppercase">
            <Icon name="arrow-left" size={13} class="transition-transform group-hover:-translate-x-0.5" />
            {t('pager.prev')}
          </span>
          <span class="font-semibold text-text transition-colors group-hover:text-accent">{prev.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block" aria-hidden="true" />
      )}

      {next ? (
        <a
          href={href(next.id)}
          rel="next"
          class="group flex flex-col items-end gap-2 rounded-lg border border-line bg-surface p-5 text-right transition-colors hover:border-accent/60"
        >
          <span class="inline-flex items-center gap-1.5 font-mono text-[0.6875rem] tracking-[0.2em] text-accent uppercase">
            {t('pager.next')}
            <Icon name="arrow-right" size={13} class="transition-transform group-hover:translate-x-0.5" />
          </span>
          <span class="font-semibold text-text transition-colors group-hover:text-accent">{next.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block" aria-hidden="true" />
      )}
    </nav>
  )
}
