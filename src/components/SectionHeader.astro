---
/** Cabecera de sección numerada, mismo lenguaje visual que las fases de los writeups. */
interface Props {
  n: string;
  label: string;
  title: string;
  intro?: string;
}

const { n, label, title, intro } = Astro.props;
---

<header class="mb-10 flex flex-col gap-3 sm:mb-12">
  <p class="flex items-center gap-3 font-mono text-xs text-faint">
    <span class="font-medium text-accent">{n}</span>
    <span class="h-px w-8 bg-line-strong" aria-hidden="true"></span>
    <span>{label}</span>
  </p>
  <h2 class="text-3xl font-semibold sm:text-4xl">{title}</h2>
  {intro && <p class="max-w-2xl text-muted">{intro}</p>}
</header>
