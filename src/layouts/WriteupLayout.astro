---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
import Icon from '../components/Icon.astro';
import WriteupPager from '../components/writeup/WriteupPager.astro';
import { formatDate, getWriteups, writeupSlug, type Writeup } from '../lib/writeups';
import { readingTime } from '../lib/reading';
import { withBase } from '../lib/url';
import { getLang, useT } from '../i18n';

interface Props {
  entry: Writeup;
  headings: MarkdownHeading[];
  prev?: { id: string; title: string } | null;
  next?: { id: string; title: string } | null;
}

const { entry, headings, prev = null, next = null } = Astro.props;
const { title, platform, os, difficulty, date, ports, tags, summary, retired } = entry.data;

const lang = getLang(Astro.url);
const t = useT(lang);

// Cada "## " del writeup es una fase
const phases = headings.filter((h) => h.depth === 2);

// Tiempo de lectura estimado (solo prosa).
const readMin = readingTime(entry.body);

// Writeups relacionados: los que más tags comparten (mismo idioma, excluyendo este).
const selfSlug = writeupSlug(entry.id);
const selfTags = new Set(tags.map((x) => x.toLowerCase()));
const related = (await getWriteups(lang))
  .filter((w) => writeupSlug(w.id) !== selfSlug)
  .map((w) => ({ w, score: w.data.tags.reduce((n, x) => n + (selfTags.has(x.toLowerCase()) ? 1 : 0), 0) }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.w.data.date.getTime() - a.w.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title={`${title} · writeup`} description={summary}>
  <article class="wrap pt-10 pb-20 sm:pt-12">
    <a
      href={withBase(lang === 'en' ? '/en/writeups/' : '/writeups/')}
      class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-accent"
    >
      <Icon name="arrow-left" size={14} /> writeups
    </a>

    <header class="mt-8 border-b border-line pb-10">
      <p class="font-mono text-xs text-faint">
        {platform} <span class="text-line-strong">/</span> {retired ? t('writeup.retired') : t('writeup.active')}
        <span class="text-line-strong">·</span> ~{readMin} {t('read.unit')}
      </p>
      <h1 class="mt-3 text-5xl font-bold sm:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{summary}</p>

      <dl
        class="mt-8 grid grid-cols-2 border-t border-l border-line font-mono text-[0.8125rem] sm:grid-cols-4"
      >
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">{t('writeup.os')}</dt>
          <dd class="mt-1 text-text">{os}</dd>
        </div>
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">{t('writeup.difficulty')}</dt>
          <dd class="mt-1"><DifficultyBadge level={difficulty} /></dd>
        </div>
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">{t('writeup.ports')}</dt>
          <dd class="mt-1 text-text">{ports.length ? ports.join(' · ') : '—'}</dd>
        </div>
        <div class="border-r border-b border-line px-4 py-3">
          <dt class="text-xs text-faint">{t('writeup.published')}</dt>
          <dd class="mt-1 text-text"><time datetime={date.toISOString()}>{formatDate(date, lang)}</time></dd>
        </div>
      </dl>

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t('card.techniques')}>
            {tags.map((t) => (
              <li class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[0.6875rem] text-muted">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[13rem_minmax(0,1fr)]">
      {
        phases.length > 0 && (
          <nav aria-label={t('writeup.phases')} class="hidden lg:block">
            <div class="sticky top-[calc(var(--nav-h)+2rem)]">
              <p class="font-mono text-xs text-faint">{t('writeup.phases')}</p>
              <ol class="mt-3 space-y-0.5 border-l border-line font-mono text-[0.8125rem]">
                {phases.map((h, i) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-phase-link={h.slug}
                      class="-ml-px flex gap-2.5 border-l border-transparent py-1 pl-3 text-muted transition-colors hover:text-text"
                    >
                      <span class="text-faint tabular-nums transition-colors">{String(i + 1).padStart(2, '0')}</span>
                      <span>{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
          <script>
            // Resalta la fase visible en la navegación lateral (scrollspy).
            const links = document.querySelectorAll<HTMLAnchorElement>('[data-phase-link]');
            const headings = [...links]
              .map((l) => document.getElementById(l.dataset.phaseLink!))
              .filter((el): el is HTMLElement => el !== null);

            function setActive(id: string) {
              links.forEach((l) => {
                const on = l.dataset.phaseLink === id;
                l.classList.toggle('border-accent', on);
                l.classList.toggle('text-text', on);
                l.classList.toggle('text-muted', !on);
                l.querySelector('span')?.classList.toggle('text-accent', on);
                l.querySelector('span')?.classList.toggle('text-faint', !on);
                if (on) l.setAttribute('aria-current', 'true');
                else l.removeAttribute('aria-current');
              });
            }

            if (headings.length) {
              const observer = new IntersectionObserver(
                (entries) => {
                  const visible = entries.filter((e) => e.isIntersecting);
                  if (visible.length) setActive(visible[0].target.id);
                },
                { rootMargin: '-20% 0px -70% 0px' },
              );
              headings.forEach((h) => observer.observe(h));
            }
          </script>
        )
      }

      <div class="writeup min-w-0 max-w-3xl">
        <slot />
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-14 border-t border-line pt-8">
          <p class="font-mono text-xs text-faint">{t('writeup.related')}</p>
          <ul class="mt-4 grid gap-4 sm:grid-cols-3">
            {related.map(({ w }) => {
              const rs = writeupSlug(w.id);
              const rhref = withBase(lang === 'en' ? `/en/writeups/${rs}/` : `/writeups/${rs}/`);
              return (
                <li>
                  <a
                    href={rhref}
                    class="group flex h-full flex-col gap-2 rounded-lg border border-line bg-surface p-4 transition-colors hover:border-accent/60"
                  >
                    <span class="flex items-center justify-between gap-2">
                      <span class="font-mono text-[0.6875rem] text-faint">
                        {w.data.platform} · {w.data.os}
                      </span>
                      <DifficultyBadge level={w.data.difficulty} />
                    </span>
                    <span class="font-semibold text-text transition-colors group-hover:text-accent">{w.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <WriteupPager prev={prev} next={next} />

    <footer class="mt-16 border-t border-line pt-6">
      <p class="max-w-3xl font-mono text-xs leading-relaxed text-faint">
        <span class="text-warn">{lang === 'en' ? 'notice' : 'aviso'}</span> · {t('writeup.footer').replace('{platform}', platform)}
      </p>
    </footer>
  </article>
</BaseLayout>
