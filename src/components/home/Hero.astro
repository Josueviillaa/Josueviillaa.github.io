---
import Icon from '../Icon.astro';
import CopyEmail from '../CopyEmail.astro';
import { site, githubUrl, linkedinUrl } from '../../config/site';
import { certs } from '../../data/certs';
import { getWriteups } from '../../lib/writeups';

const writeups = await getWriteups();
const earned = certs.filter((c) => c.status === 'obtenida').map((c) => c.code);

// Ficha del panel "terminal": todo sale de config/datos, nada inventado aquí.
const profile = [
  ['rol', 'pentester junior'],
  ['formación', 'máster en ciberseguridad · en curso'],
  ['certs', earned.length ? earned.join(', ') : '—'],
  ['writeups', `${writeups.length} ${writeups.length === 1 ? 'máquina' : 'máquinas'} · HTB`],
];
---

<section class="relative overflow-hidden border-b border-line">
  <!-- Retícula de cuaderno, muy tenue -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-60 [background-image:linear-gradient(var(--line)_1px,transparent_1px),linear-gradient(90deg,var(--line)_1px,transparent_1px)] [background-size:2rem_2rem] [mask-image:radial-gradient(ellipse_70%_80%_at_20%_0%,black,transparent_75%)]"
  >
  </div>

  <div class="wrap relative grid items-center gap-12 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:grid-cols-[1.25fr_1fr]">
    <div class="min-w-0">
      <p class="flex items-center gap-2.5 font-mono text-xs text-muted">
        <span class="status-dot" aria-hidden="true"></span>
        <span>{site.status}</span>
      </p>

      <h1 class="mt-6 text-6xl font-bold sm:text-7xl">{site.name}</h1>

      <p class="mt-4 font-display text-lg font-medium text-text sm:text-xl">{site.role}</p>

      <p class="mt-5 max-w-xl text-lg text-muted">{site.pitch}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="github" /> GitHub
        </a>
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="linkedin" /> LinkedIn
        </a>
        <CopyEmail email={site.email} />
      </div>
    </div>

    <div class="min-w-0 overflow-hidden rounded-lg border border-line bg-surface" aria-label="Resumen de perfil">
      <div class="flex items-center justify-between border-b border-line bg-raised px-4 py-2 font-mono text-xs text-faint">
        <span>josu@kali: ~</span>
        <span>zsh</span>
      </div>
      <div class="space-y-1 p-5 font-mono text-[0.8125rem] leading-7">
        <p><span class="text-accent">$</span> <span class="text-text">cat perfil.txt</span></p>
        <dl class="grid grid-cols-[6.5rem_1fr] gap-x-3 pb-1">
          {
            profile.map(([k, v]) => (
              <>
                <dt class="text-faint">{k}</dt>
                <dd class="text-muted">{v}</dd>
              </>
            ))
          }
        </dl>
        <p><span class="text-accent">$</span><span class="cursor" aria-hidden="true"></span></p>
      </div>
    </div>
  </div>
</section>
