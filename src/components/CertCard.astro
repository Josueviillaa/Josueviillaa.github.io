---
import type { Cert } from '../data/certs';
import Icon from './Icon.astro';
import { getLang, useT } from '../i18n';

interface Props {
  cert: Cert;
}

const { cert } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);

const statusLabel = t(`cert.status.${cert.status}` as 'cert.status.obtenida');
// Tamaño del código grabado dentro del emblema, según longitud.
const codeFont = cert.code.length >= 5 ? 20 : 26;
const codeY = (118 + codeFont * 0.34).toFixed(1);
---

<article class:list={['cert-card', `is-${cert.status}`]} data-cert-card>
  <div class="cert-badge" data-cert-badge aria-hidden="true">
    <svg class="cert-medal" viewBox="20 30 180 192" xmlns="http://www.w3.org/2000/svg">
      <!-- Caras del hexágono (luz desde arriba-izquierda) -->
      <polygon class="facet" points="110,118 20,82 110,30" fill="#74838f"></polygon>
      <polygon class="facet" points="110,118 110,30 200,82" fill="#64737f"></polygon>
      <polygon class="facet" points="110,118 200,82 192,196" fill="#3f4a55"></polygon>
      <polygon class="facet" points="110,118 192,196 110,222" fill="#2b333c"></polygon>
      <polygon class="facet" points="110,118 110,222 28,196" fill="#262d35"></polygon>
      <polygon class="facet" points="110,118 28,196 20,82" fill="#4c5a66"></polygon>

      <!-- Aristas finas (cortes del metal) -->
      <g stroke="#ffffff" stroke-width="0.5" opacity="0.1">
        <line x1="110" y1="118" x2="110" y2="30"></line>
        <line x1="110" y1="118" x2="200" y2="82"></line>
        <line x1="110" y1="118" x2="192" y2="196"></line>
        <line x1="110" y1="118" x2="110" y2="222"></line>
        <line x1="110" y1="118" x2="28" y2="196"></line>
        <line x1="110" y1="118" x2="20" y2="82"></line>
      </g>

      <!-- Contorno exterior biselado -->
      <polygon
        class="rim"
        points="110,30 200,82 192,196 110,222 28,196 20,82"
        fill="none"
        stroke-width="2"></polygon>

      <!-- Emblema central: moneda grabada con el código -->
      <circle cx="110" cy="118" r="34" fill="#1b222a"></circle>
      <circle cx="110" cy="118" r="34" fill="none" stroke="#ffffff" stroke-width="0.5" opacity="0.08"></circle>
      <circle class="rim" cx="110" cy="118" r="33" fill="none" stroke-width="1.1" opacity="0.7"></circle>
      <text
        x="110"
        y={codeY}
        text-anchor="middle"
        fill="#05100d"
        opacity="0.55"
        style={`font-family:var(--font-display);font-weight:700;font-size:${codeFont}px;letter-spacing:-0.02em`}
        transform="translate(0,1)">{cert.code}</text>
      <text
        class="code"
        x="110"
        y={codeY}
        text-anchor="middle"
        style={`font-family:var(--font-display);font-weight:700;font-size:${codeFont}px;letter-spacing:-0.02em`}
        >{cert.code}</text>
    </svg>

    <!-- Reflejo que glisa con el ratón (suave, por encima del metal) -->
    <span class="cert-shine"></span>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-base leading-snug font-semibold text-text sm:text-lg">{cert.name}</h3>
      <span class="cert-pill">{statusLabel}</span>
    </div>
    <p class="mt-1.5 font-mono text-xs text-faint">{cert.issuer}{cert.date && ` · ${cert.date}`}</p>

    {cert.note && <p class="mt-3 text-sm text-muted">{cert.note}</p>}

    {
      cert.verifyUrl && (
        <a
          href={cert.verifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link mt-4 inline-flex items-center gap-1.5 font-mono text-xs"
        >
          {t('cert.verify')} <Icon name="arrow-right" size={14} />
        </a>
      )
    }
  </div>
</article>

<style>
  /* Posición del reflejo (0–100). Registrada para poder transicionarla:
     el brillo "glisa" hacia el ratón en vez de saltar. */
  @property --mx {
    syntax: '<number>';
    inherits: true;
    initial-value: 50;
  }
  @property --my {
    syntax: '<number>';
    inherits: true;
    initial-value: 38;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid var(--line);
    border-left-width: 2px;
    border-radius: 0 0.7rem 0.7rem 0;
    background: var(--surface);
    padding: 1.4rem 1.5rem;
    transition: border-color 0.3s ease;
  }
  .is-obtenida {
    border-left-color: var(--accent);
  }
  .is-en-curso {
    border-left-color: var(--warn);
  }
  .is-planificada {
    border-left-color: var(--line-strong);
  }

  /* Emblema */
  .cert-badge {
    --mx: 50;
    --my: 38;
    --rim: var(--accent);
    position: relative;
    width: 96px;
    height: 102px;
    flex: none;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.45));
    transition:
      --mx 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      --my 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s ease,
      filter 0.4s ease;
  }
  .is-en-curso .cert-badge {
    --rim: var(--warn);
  }
  .is-planificada .cert-badge {
    --rim: var(--line-strong);
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.3)) grayscale(0.5) brightness(0.82);
    opacity: 0.82;
  }

  .cert-medal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .rim {
    stroke: var(--rim);
    opacity: 0.55;
  }
  .code {
    fill: #eaf2f0;
  }
  .is-planificada .code {
    fill: #aeb8c0;
  }

  /* Reflejo: destello blanco suave centrado en (--mx,--my), recortado al hexágono.
     'screen' lo hace leer como luz sobre metal; glisa gracias a @property. */
  .cert-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: polygon(50% 0%, 100% 27.1%, 95.6% 86.5%, 50% 100%, 4.4% 86.5%, 0% 27.1%);
    background: radial-gradient(
      40% 36% at calc(var(--mx) * 1%) calc(var(--my) * 1%),
      rgba(255, 255, 255, 0.5),
      rgba(255, 255, 255, 0) 62%
    );
    mix-blend-mode: screen;
    opacity: 0.55;
    transition: opacity 0.4s ease;
  }
  /* Un segundo foco, más estrecho, da el "glint" especular. */
  .cert-shine::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      16% 14% at calc(var(--mx) * 1%) calc(var(--my) * 1%),
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0) 60%
    );
    mix-blend-mode: screen;
  }
  .is-planificada .cert-shine {
    opacity: 0.12;
  }

  /* Al pasar el ratón: sube un pelo, el reflejo gana fuerza y aparece un halo del acento. */
  .cert-card:hover .cert-badge {
    transform: translateY(-2px);
  }
  .is-obtenida:hover .cert-badge,
  .is-en-curso:hover .cert-badge {
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 10px color-mix(in srgb, var(--rim) 42%, transparent));
  }
  .cert-card:hover .cert-shine {
    opacity: 0.9;
  }

  /* Píldora de estado */
  .cert-pill {
    flex: none;
    border: 1px solid;
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .is-obtenida .cert-pill {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }
  .is-en-curso .cert-pill {
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 40%, transparent);
    background: var(--warn-soft);
  }
  .is-planificada .cert-pill {
    color: var(--text-faint);
    border-color: var(--line-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-badge {
      transition: filter 0.3s ease;
    }
    .cert-card:hover .cert-badge {
      transform: none;
    }
  }

  @media (max-width: 400px) {
    .cert-card {
      gap: 1rem;
      padding: 1.25rem;
    }
    .cert-badge {
      width: 80px;
      height: 85px;
    }
  }
</style>

<script>
  const badges = document.querySelectorAll<HTMLElement>('[data-cert-badge]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  badges.forEach((badge) => {
    const card = badge.closest<HTMLElement>('[data-cert-card]');
    if (!card || reduce) return;
    // El reflejo sigue al ratón sobre TODA la tarjeta (zona cómoda), suavizado por CSS.
    card.addEventListener('pointermove', (e) => {
      const r = badge.getBoundingClientRect();
      const mx = ((e.clientX - r.left) / r.width) * 100;
      const my = ((e.clientY - r.top) / r.height) * 100;
      badge.style.setProperty('--mx', Math.max(-20, Math.min(120, mx)).toFixed(1));
      badge.style.setProperty('--my', Math.max(-20, Math.min(120, my)).toFixed(1));
    });
    card.addEventListener('pointerleave', () => {
      badge.style.setProperty('--mx', '50');
      badge.style.setProperty('--my', '38');
    });
  });
</script>
