---
import { render } from 'astro:content';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Terminal from '../../../components/writeup/Terminal.astro';
import Lesson from '../../../components/writeup/Lesson.astro';
import Callout from '../../../components/Callout.astro';
import AttackChain from '../../../components/writeup/AttackChain.astro';
import { getTools, toolSlug, type Tool } from '../../../lib/tools';

export async function getStaticPaths() {
  const entries = await getTools('en');
  return entries.map((entry) => ({ params: { slug: toolSlug(entry.id) }, props: { entry } }));
}

interface Props {
  entry: Tool;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ToolLayout entry={entry} headings={headings}>
  <Content components={{ Terminal, Lesson, Callout, AttackChain }} />
</ToolLayout>
