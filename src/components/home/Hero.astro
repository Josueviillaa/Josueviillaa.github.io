---
import Icon from '../Icon.astro';
import CopyEmail from '../CopyEmail.astro';
import HeroTerminal from './HeroTerminal.astro';
import { site, content, githubUrl, linkedinUrl, htbUrl } from '../../config/site';
import { getLang } from '../../i18n';

const lang = getLang(Astro.url);
const c = content[lang];
---

<section class="relative overflow-hidden border-b border-line">
  <!-- Retícula de cuaderno, muy tenue -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-60 [background-image:linear-gradient(var(--line)_1px,transparent_1px),linear-gradient(90deg,var(--line)_1px,transparent_1px)] [background-size:2rem_2rem] [mask-image:radial-gradient(ellipse_70%_80%_at_20%_0%,black,transparent_75%)]"
  >
  </div>

  <div class="wrap relative grid items-center gap-12 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:grid-cols-[1.25fr_1fr]">
    <div class="min-w-0">
      <p class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-muted">
        <span class="status-dot" aria-hidden="true"></span>
        <span>{c.status}</span>
      </p>

      <p class="mt-7 font-mono text-sm tracking-[0.25em] text-faint uppercase">
        <span class="text-accent">{site.handle}</span> · {site.name}
      </p>

      <h1 data-scramble class="mt-3 font-display text-[2rem] font-bold leading-[1.08] tracking-tight text-text sm:text-5xl">
        {c.headline}
      </h1>

      <p class="mt-5 font-display text-lg font-medium text-muted sm:text-xl">{c.role}</p>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:text-lg">{c.pitch}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="github" /> GitHub
        </a>
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="linkedin" /> LinkedIn
        </a>
        <a
          href={htbUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-line bg-surface px-3.5 font-mono text-[0.8125rem] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="htb" /> HackTheBox
        </a>
        <CopyEmail email={site.email} />
      </div>
    </div>

    <HeroTerminal />
  </div>
</section>

<script>
  // El titular se "descifra" al cargar (scramble). El texto real está en el
  // HTML (SEO/no-JS); esto solo lo anima. Se omite con prefers-reduced-motion.
  const el = document.querySelector<HTMLElement>('[data-scramble]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const final = el.textContent || '';
    const glyphs = '!<>-_\\/[]{}=+*^?#01';
    const settleAt = Array.from(final).map((_, i) => 8 + i * 1.25);
    let frame = 0;
    function tick() {
      let outText = '';
      let settled = 0;
      for (let i = 0; i < final.length; i++) {
        if (final[i] === ' ') { outText += ' '; settled++; continue; }
        if (frame >= settleAt[i]) { outText += final[i]; settled++; }
        else outText += glyphs[(Math.random() * glyphs.length) | 0];
      }
      el!.textContent = outText;
      frame++;
      if (settled < final.length) requestAnimationFrame(tick);
      else el!.textContent = final;
    }
    tick();
  }
</script>
