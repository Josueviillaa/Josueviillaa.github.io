---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import { site, content, githubUrl, linkedinUrl, htbUrl } from '../config/site';
import { withBase } from '../lib/url';
import { getLang, useT, localeTag, ogLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const c = content[lang];

const { title, description = c.description, isHome = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${c.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

// hreflang para la home (las dos versiones de idioma)
const esHome = new URL(withBase('/'), Astro.site);
const enHome = new URL(withBase('/en/'), Astro.site);

// Datos estructurados (schema.org Person) — ayuda a buscadores a entender quién es Josu.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: c.role,
  description: c.description,
  url: esHome.href,
  email: `mailto:${site.email}`,
  sameAs: [githubUrl, linkedinUrl, htbUrl],
  knowsLanguage: ['Spanish', 'English'],
  knowsAbout: [
    'Penetration testing',
    'Offensive security',
    'Active Directory',
    'Web application security',
    'Privilege escalation',
    'OWASP Top 10',
    'HackTheBox',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'eJPT — eLearnSecurity Junior Penetration Tester',
  },
};
---

<!doctype html>
<html lang={localeTag[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Seguridad: limita de dónde se puede cargar contenido (CSP) y qué referrer se envía. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {
      isHome && (
        <>
          <link rel="alternate" hreflang="es" href={esHome} />
          <link rel="alternate" hreflang="en" href={enHome} />
          <link rel="alternate" hreflang="x-default" href={esHome} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — writeups y notas`} href={withBase('/rss.xml')} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(withBase('/og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${c.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(withBase('/og.png'), Astro.site)} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

    <!-- Aplica el tema guardado ANTES de pintar, para evitar parpadeo -->
    <script is:inline>
      try {
        const tm = localStorage.getItem('theme');
        if (tm === 'light' || tm === 'dark') document.documentElement.dataset.theme = tm;
      } catch {}
    </script>

    {
      /* Primera visita a la home en español: si el navegador no está en español,
         redirige a /en/. La elección del switch se guarda y manda sobre esto. */
      isHome && lang === 'es' && (
        <script
          is:inline
          set:html={`try{if(!localStorage.getItem('lang')){var n=(navigator.language||'').toLowerCase();if(n&&n.indexOf('es')!==0){localStorage.setItem('lang','en');location.replace(${JSON.stringify(enHome.pathname)});}else{localStorage.setItem('lang','es');}}}catch(e){}`}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>

  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:font-mono focus:text-sm focus:text-accent-ink"
    >
      {t('a11y.skip')}
    </a>

    <Nav isHome={isHome} />

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="wrap flex flex-col gap-2 py-8 font-mono text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {site.name}</p>
        <div class="flex items-center gap-4">
          <a href={withBase(lang === 'en' ? '/en/privacy/' : '/privacidad/')} class="transition-colors hover:text-text">
            {t('privacy.nav')}
          </a>
          <a href={withBase('/rss.xml')} class="transition-colors hover:text-text">rss</a>
        </div>
        <p>{t('footer.note')}</p>
      </div>
    </footer>

    <PrivacyNotice />

    <!-- Glosario: en táctil, tocar un término muestra/oculta su definición;
         Escape o un toque fuera lo cierran. En ratón/teclado basta hover/foco. -->
    <script is:inline>
      (function () {
        function closeAll(except) {
          document.querySelectorAll('abbr.gl.is-open').forEach(function (el) {
            if (el !== except) el.classList.remove('is-open');
          });
        }
        document.addEventListener('click', function (e) {
          var el = e.target instanceof Element ? e.target.closest('abbr.gl') : null;
          if (el) {
            e.preventDefault();
            var open = el.classList.contains('is-open');
            closeAll(el);
            el.classList.toggle('is-open', !open);
          } else {
            closeAll(null);
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeAll(null);
        });
      })();
    </script>
  </body>
</html>
